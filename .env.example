# We Graduated Fantasy API — Yahoo OAuth credentials
# Copy this to `.env` and fill in the values. .env is gitignored.
#
# The Consumer Key/Secret come from Pete's Yahoo Developer app (the same
# one used for I Yearn should work — one Yahoo app can cover multiple
# leagues on the same account).
#
# LEAGUE_ID is the numeric ID from the We Graduated Stuff Yahoo league URL
# (the number in the /f1/<id> segment). Update it every season when the
# league starts a new year.

YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
YAHOO_LEAGUE_ID=

# The tokens below are populated automatically after the first OAuth run.
# Leave blank until then.
YAHOO_ACCESS_TOKEN=
YAHOO_GUID=
YAHOO_REFRESH_TOKEN=
YAHOO_TOKEN_TIME=
YAHOO_TOKEN_TYPE=
